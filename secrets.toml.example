# ─────────────────────────────────────────────
# .streamlit/secrets.toml
# DO NOT commit this file to GitHub!
# Streamlit Cloud → App settings → Secrets
# ─────────────────────────────────────────────

ANTHROPIC_API_KEY = "sk-ant-..."

# ── Neon (serverless Postgres) ───────────────
# Use the POOLED endpoint: the host contains "-pooler".
# Neon console → your project → Connection string → "Pooled connection".
NEON_DATABASE_URL = "postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/dkm?sslmode=require"

# ── Google Sheets (optional) ─────────────────
# Leave both out to run on Neon only. Keep them to write to both backends.
GOOGLE_SHEETS_ID  = "your-spreadsheet-id"
GOOGLE_SERVICE_ACCOUNT = """
{ ... full service account JSON ... }
"""

# ── Cost display (optional) ──────────────────
# USD per EUR, only used to show a second figure next to the dollar amount.
USD_PER_EUR = 1.09

# Override token rates (USD per million tokens) when Anthropic changes them,
# without touching utils/pricing.py:
# [MODEL_PRICING]
# "claude-sonnet-5" = { input = 2.0, output = 10.0 }
# "claude-opus-5"   = { input = 5.0, output = 25.0 }
